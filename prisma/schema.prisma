generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  mobile    String?
  fullName  String?
  bookmarks Bookmark[]
}

model Book {
  id               Int            @id @default(autoincrement())
  title            String
  author           String
  language         String
  coverImage       String?
  smallDescription String?
  content          String?
  pageCount        Int?
  audioLink        String?
  relatedInfo      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  layout           LayoutType     @default(MIXED)
  images           String[]
  bookmarks        Bookmark[]
  contentBlocks    ContentBlock[]
  categories       Category[]     @relation("BookToCategory")
}

model ContentBlock {
  id      Int       @id @default(autoincrement())
  type    BlockType
  content String
  order   Int
  bookId  Int
  book    Book      @relation(fields: [bookId], references: [id])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  books     Book[]   @relation("BookToCategory")
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  bookId    Int
  userId    Int
  progress  Float    @default(0.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  book      Book     @relation(fields: [bookId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, bookId])
}

enum BlockType {
  TEXT
  IMAGE
}

enum LayoutType {
  FULL_TEXT
  IMAGE_TOP_TEXT_BOTTOM
  TEXT_TOP_IMAGE_BOTTOM
  MIXED
}
